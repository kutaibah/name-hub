# Canton Names — public (browser) configuration
# Copy to .env.local for local development.

# demo = fixtures only (default on Vercel). live = same-origin API routes → upstream.
NEXT_PUBLIC_CNS_MODE=demo

# Network label for UI: demo | localnet | devnet | mainnet (only applies when mode=live)
NEXT_PUBLIC_CNS_NETWORK=demo

# Browser resolve endpoint (same-origin; default is fine)
NEXT_PUBLIC_CNS_RESOLVE_URL=/api/cns/resolve

# --- Server-only (never NEXT_PUBLIC_). Required when NEXT_PUBLIC_CNS_MODE=live ---

# Preset: localnet | devnet | mainnet (fills upstream URL, style, and ANS acronym)
CNS_NETWORK=localnet

# Override preset upstream base URL:
# - scan style: https://scan.sv-1.dev.../api/scan  OR  http://scan.localhost:4000/api/scan
# - scan-proxy style (DevNet via your validator): https://your-validator.example/api/validator
# CNS_UPSTREAM_URL=

# scan (direct Scan) | scan-proxy (validator BFT proxy)
# CNS_UPSTREAM_STYLE=scan

# Optional bearer token for scan-proxy / authenticated validator APIs
# CNS_UPSTREAM_TOKEN=

# Override ANS acronym (localnet default: ans, devnet/mainnet: cns)
# CNS_ANS_ACRONYM=ans
