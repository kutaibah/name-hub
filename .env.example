# Canton Names Environment Configuration
# Copy this file to .env.local and fill in your values

# Mode: "demo" or "live"
# Demo mode uses simulated data and doesn't require network access
NEXT_PUBLIC_CNS_MODE=demo

# Scan API URL for name resolution (public, no auth required)
# Default: https://scan.sv-1.global.canton.network.sync.global/api/scan
NEXT_PUBLIC_SCAN_API_URL=

# Validator API URL for registration (requires authentication)
# Required for live mode registration
NEXT_PUBLIC_VALIDATOR_API_URL=

# Network name displayed in the UI
NEXT_PUBLIC_NETWORK_NAME=DevNet
