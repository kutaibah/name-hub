{
  "name": "canton-names",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --port 3847",
    "predev": "pnpm --filter @canton-names/resolver build",
    "prebuild": "cp docs/pitches/canton-names-pitch.html public/pitch/index.html && cp docs/pitches/pitch-judges/pitch-judges.html public/pitch-judges/index.html",
    "build:resolver": "pnpm --filter @canton-names/resolver build",
    "build": "pnpm build:resolver && next build",
    "test": "pnpm --filter @canton-names/resolver test && vitest run",
    "test:app": "vitest run",
    "start": "next start --port 3847",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@canton-names/resolver": "workspace:*",
    "@tanstack/react-query": "^5.62.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.3.0",
    "lucide-react": "^0.469.0",
    "next": "16.3.5",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^2.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "playwright": "^1.63.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^2.1.0"
  },
  "packageManager": "pnpm@10.33.3"
}
