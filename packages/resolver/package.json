{
  "name": "@canton-names/resolver",
  "version": "0.1.3",
  "description": "Typed Canton name resolution with safe recipient UI — lookup is the product, safety is the differentiator.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kutaibah/name-hub.git",
    "directory": "packages/resolver"
  },
  "homepage": "https://github.com/kutaibah/name-hub#readme",
  "bugs": {
    "url": "https://github.com/kutaibah/name-hub/issues"
  },
  "keywords": [
    "canton",
    "cns",
    "name-service",
    "resolver",
    "react"
  ],
  "sideEffects": [
    "*.css"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && cp src/styles/cns-recipient-input.css dist/styles.css",
    "test": "vitest run",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
